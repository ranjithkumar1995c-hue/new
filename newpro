package OopsPractise;
//Constructor overloading ,same name but Different Signature of parameter.
public class PractiseConstructor {
// Constructor.
	PractiseConstructor(){
		System.out.println("Default Constructor");
	}
	PractiseConstructor(int a,int b){
		int c=a*b;
		System.out.println("Product:"+c);
	}
	PractiseConstructor(int x,float d){
		float y=(float)x+d;
		System.out.println("sum"+y);
	}
	PractiseConstructor(String name,long price){
		System.out.println("Car Brandname"+name);
		System.out.println("Car price"+price);
		
	}
	public static void main(String[] args) {
		PractiseConstructor p=new  PractiseConstructor();
		PractiseConstructor p1=new PractiseConstructor(10,20);
		PractiseConstructor p2=new PractiseConstructor(10,10.4f);
		PractiseConstructor p3=new PractiseConstructor("Rolls Royce",100000L);
		}

}

