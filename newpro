package OopsPractise;
class parent{
	int rollno=103;
	String name="ragu";
	public void show() {
		System.out.println("Parent class method is created.....");
	}
}
class child extends parent{
	public void show() {
		String name="ramu";
		System.out.println("child class method is ceated");
		System.out.println("name of  childbe:"+super.name);
		System.out.println("name of  currentchild:"+name);
	}
	
}
public class Inheritancepractise {

	public static void main(String[] args) {
//Object.
		child b=new child();
		b.show();
		

	}

}

